rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /siteComments/{commentId} {
   allow read: if true;
   allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() <= 100 && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500 && request.resource.data.createdAt == request.time;
   allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
  }
 }
}
